<?xml version="1.0" encoding="utf-8"?>
<!-- TELA DE PÁGINA DO DIÁRIO: Mostra a página de anotação e o dia em que a página foi criada -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/paginaRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cor_fundo_app"
    android:orientation="vertical"
    tools:context=".PaginaActivity">

    <!-- BARRA SUPERIOR DE NAVEGAÇÃO DO DIÁRIO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cor_primaria"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <Button
            android:id="@+id/buttonVoltarInicio"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="◀ Dias"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewNumeroPagina"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Página 1 de 1"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonNovaPaginaTopo"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Página"
            android:textColor="#FFE082"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- CONTEÚDO ROLÁVEL DA FOLHA DO DIÁRIO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="14dp">

        <!-- CARTÃO QUE SIMULA A FOLHA DE PAPEL DO DIÁRIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_folha_diario"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- DESTAQUE OBRIGATÓRIO: MOSTRA O DIA EM QUE A PÁGINA FOI CRIADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_data"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Data de criação"
                    android:src="@drawable/ic_calendario" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DIA EM QUE ESTA PÁGINA FOI CRIADA:"
                        android:textColor="@color/cor_texto_secundario"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textViewDataCriacaoPagina"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="14/11/2026 (Sábado) às 21:15"
                        android:textColor="@color/cor_primaria_escura"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SELETOR DE HUMOR DO DIA (OPCIONAL E FÁCIL DE MODIFICAR NO XML) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Como foi este dia?"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/radioGroupHumor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioHumorFeliz"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Feliz"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/radioHumorTranquilo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Calmo"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/radioHumorPensativo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pensativo"
                    android:textSize="12sp" />

                <RadioButton
                    android:id="@+id/radioHumorGrato"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grato"
                    android:textSize="12sp" />
            </RadioGroup>

            <!-- CAMPO DE TÍTULO DA PÁGINA -->
            <EditText
                android:id="@+id/editTextTituloPagina"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:hint="@string/hint_titulo_pagina"
                android:inputType="textCapSentences"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="@color/cor_texto_principal"
                android:textColorHint="@color/cor_texto_secundario"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- LINHA DIVISÓRIA DO CADERNO -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1.5dp"
                android:layout_marginBottom="10dp"
                android:background="@color/cor_linha_caderno" />

            <!-- ÁREA DE ANOTAÇÃO DA PÁGINA DO DIÁRIO -->
            <EditText
                android:id="@+id/editTextConteudoPagina"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="top|start"
                android:hint="@string/hint_conteudo_pagina"
                android:inputType="textMultiLine|textCapSentences"
                android:lineSpacingExtra="6dp"
                android:minHeight="240dp"
                android:paddingTop="4dp"
                android:paddingBottom="12dp"
                android:textColor="@color/cor_texto_principal"
                android:textColorHint="@color/cor_texto_secundario"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

    <!-- BARRA DE FOLHEAR PÁGINAS (ANTERIOR / PRÓXIMA) E AÇÕES (SALVAR / EXCLUIR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cor_folha_diario"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <!-- NAVEGAÇÃO ENTRE PÁGINAS DO DIÁRIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/buttonPaginaAnterior"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/btn_pagina_anterior"
                android:textColor="@color/cor_primaria"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textViewIndiceFolha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Folha 1"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/buttonProximaPagina"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="@string/btn_proxima_pagina"
                android:textColor="@color/cor_primaria"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- BOTÕES DE SALVAR E EXCLUIR PÁGINA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/buttonExcluirPagina"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginEnd="10dp"
                android:text="@string/btn_excluir_pagina"
                android:textColor="@color/cor_excluir" />

            <Button
                android:id="@+id/buttonSalvarPagina"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="@color/cor_primaria"
                android:text="@string/btn_salvar_pagina"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

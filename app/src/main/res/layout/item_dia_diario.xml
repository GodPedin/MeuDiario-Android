<?xml version="1.0" encoding="utf-8"?>
<!-- ITEM DA LISTA NA TELA INICIAL: Representa um dia em que o usuário anotou algo no diário -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_dia"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- BLOCO DE DATA (DIA E MÊS EM DESTAQUE) -->
    <LinearLayout
        android:layout_width="60dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_badge_data"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="4dp">

        <TextView
            android:id="@+id/textViewDiaNumero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14"
            android:textColor="@color/cor_primaria"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewMesAbreviado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOV"
            android:textAllCaps="true"
            android:textColor="@color/cor_secundaria"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- INFORMAÇÕES DO DIA E PRÉVIA DAS PÁGINAS ANOTADAS -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewDataCompletaDia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="14/11/2026 (Sábado)"
                android:textColor="@color/cor_texto_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewQuantidadePaginasDia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_data"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="1 pág."
                android:textColor="@color/cor_primaria"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewResumoAnotacaoDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Título ou prévia da anotação feita neste dia..."
            android:textColor="@color/cor_texto_secundario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textViewAbrirPaginaHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Toque para abrir as páginas deste dia ▶"
            android:textColor="@color/cor_destaque"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
